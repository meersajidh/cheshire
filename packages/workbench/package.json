{
  "name": "@dinah/workbench",
  "version": "0.0.0",
  "type": "module",
  "description": "The dinah application shell — activity bar, sidebar, editor area, status bar",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/workbench.js"
    },
    "./style.css": "./dist/workbench.css",
