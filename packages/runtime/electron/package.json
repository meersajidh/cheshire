{
  "name": "@mogget/runtime-electron",
  "version": "0.1.0",
  "type": "module",
  "description": "mogget's Electron runtime — process entry, window creation, lifecycle",
  "license": "MIT",
  "homepage": "https://github.com/meersajidh/mogget",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meersajidh/mogget.git",
    "directory": "packages/runtime/electron"
  },
  "bugs": "https://github.com/meersajidh/mogget/issues",
  "keywords": [
    "mogget",
    "desktop",
    "framework",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@mogget/core": "workspace:^"
  },
  "devDependencies": {
    "electron": "catalog:",
    "typescript": "catalog:"
  }
}
