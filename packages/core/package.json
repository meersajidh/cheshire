{
  "name": "@cheshire/core",
  "version": "0.1.2",
  "type": "module",
  "description": "cheshire foundational services and the cheshire.config contract",
  "license": "MIT",
  "homepage": "https://github.com/meersajidh/cheshire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meersajidh/cheshire.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/meersajidh/cheshire/issues",
  "keywords": [
    "cheshire",
    "desktop",
    "framework"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    },
    "./views/internal": {
      "types": "./dist/views-internal.d.ts",
      "default": "./dist/views-internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
