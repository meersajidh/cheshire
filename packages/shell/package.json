{
  "name": "@cheshire/shell",
  "version": "0.1.0",
  "type": "module",
  "description": "The cheshire shell \u2014 title bar, body, status bar; the root of the renderer",
  "license": "MIT",
  "homepage": "https://github.com/meersajidh/cheshire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meersajidh/cheshire.git",
    "directory": "packages/shell"
  },
  "bugs": "https://github.com/meersajidh/cheshire/issues",
  "keywords": [
    "cheshire",
    "desktop",
    "framework",
    "react"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/lib/shell.js"
    },
    "./style.css": "./dist/lib/shell.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@cheshire/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
