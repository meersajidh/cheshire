{
  "name": "@cheshire/app",
  "version": "0.1.2",
  "type": "module",
  "description": "The application's surface onto cheshire — the only @cheshire package an application imports",
  "license": "MIT",
  "homepage": "https://github.com/meersajidh/cheshire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meersajidh/cheshire.git",
    "directory": "packages/app"
  },
  "bugs": "https://github.com/meersajidh/cheshire/issues",
  "keywords": [
    "cheshire",
    "desktop",
    "framework"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@cheshire/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
