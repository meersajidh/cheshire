{
  "name": "mogget",
  "version": "0.1.0",
  "type": "module",
  "description": "The mogget CLI — dev, build, package — and the application-facing config API",
  "license": "MIT",
  "homepage": "https://github.com/meersajidh/mogget",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meersajidh/mogget.git",
    "directory": "cli/mogget"
  },
  "bugs": "https://github.com/meersajidh/mogget/issues",
  "keywords": [
    "mogget",
    "desktop",
    "framework",
    "electron",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mogget": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@mogget/core": "workspace:^",
    "@mogget/runtime-electron": "workspace:^",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  }
}
