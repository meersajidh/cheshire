{
  "name": "cheshire-framework",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "cheshire — a platform for building desktop applications",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "pack:local": "node scripts/pack-local.mjs",
    "registry:start": "node scripts/registry-local.mjs start",
    "registry:publish": "node scripts/registry-local.mjs publish",
    "registry:status": "node scripts/registry-local.mjs status",
    "registry:reset": "node scripts/registry-local.mjs reset",
    "clean": "pnpm -r exec rm -rf dist && rm -rf .cheshire"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.62.0",
    "vitest": "catalog:"
  }
}
